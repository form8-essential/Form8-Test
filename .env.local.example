# ─────────────────────────────────────────────────────────────
# คัดลอกไฟล์นี้เป็น .env.local แล้วเติมค่าจริง (อย่า commit .env.local)
# บน Vercel ให้ใส่ค่าเหล่านี้ใน Project → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────

# ---- Supabase (จำเป็น) ----
# หาได้ที่ Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# SERVICE ROLE KEY = ฝั่ง server เท่านั้น ห้ามขึ้นต้นด้วย NEXT_PUBLIC_ และห้าม expose ให้ client
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...service_role...

# ---- Pixels / Analytics (ใส่เมื่อพร้อมยิงแอด) ----
# ว่างไว้ได้ ระบบจะข้ามการโหลด script ที่ยังไม่มีค่า
NEXT_PUBLIC_GA4_ID=            # เช่น G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=     # เช่น 1234567890
NEXT_PUBLIC_TIKTOK_PIXEL_ID=   # เช่น XXXXXXXXXXXXXXXXXXX

# ---- Resend (ทางเลือก: แจ้งเตือนอีเมลเมื่อมี lead ใหม่) ----
# ปล่อยว่างได้ ถ้าไม่ใส่ ระบบจะไม่ส่งอีเมล
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=            # อีเมลผู้รับแจ้งเตือน เช่น you@example.com
LEAD_FROM_EMAIL=onboarding@resend.dev
